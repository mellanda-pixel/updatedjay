---
layout: base.njk
title: Book Now
description: Book your tattoo consultation or session with J. Atlanta-based tattoo artist specializing in black and gray realism.
permalink: /book/
---

<header class="page-header">
    <div class="container">
        <span class="section-tag">Let's Do This</span>
        <h1>Book Now</h1>
        <p>Answer one quick question to get started.</p>
    </div>
</header>

<section class="book-content">
    <div class="container">
        
        <!-- Client Type Question -->
        <div class="client-question" id="clientQuestion">
            <h2>Have you had a consultation with J before?</h2>
            <p>This helps us send you to the right place.</p>
            <div class="question-buttons">
                <button class="question-btn" id="btnNo">NO, I'M NEW</button>
                <button class="question-btn" id="btnYes">YES, I HAVE</button>
            </div>
        </div>

        <!-- New Client Section -->
        <div class="client-section" id="new-client">
            <div class="back-link">
                <a href="#" id="backToQuestion">← Back</a>
            </div>
            <div class="book-grid">
                <div class="book-info">
                    <h2>First Time Here?</h2>
                    <p>All new clients start with a consultation. This is where we discuss your idea, placement, sizing, and make sure we're a good fit. The $50 consultation fee goes toward your tattoo.</p>
                    
                    <div class="book-steps">
                        <div class="book-step">
                            <span class="book-step-number">01</span>
                            <div class="book-step-content">
                                <h4>Fill Out The Form</h4>
                                <p>Tell me about your tattoo idea — the more detail, the better.</p>
                            </div>
                        </div>
                        <div class="book-step">
                            <span class="book-step-number">02</span>
                            <div class="book-step-content">
                                <h4>Pay Consultation Fee</h4>
                                <p>$50 secures your consultation spot. This goes toward your tattoo.</p>
                            </div>
                        </div>
                        <div class="book-step">
                            <span class="book-step-number">03</span>
                            <div class="book-step-content">
                                <h4>Book Your Time</h4>
                                <p>After payment, you'll pick a consultation time that works for you.</p>
                            </div>
                        </div>
                        <div class="book-step">
                            <span class="book-step-number">04</span>
                            <div class="book-step-content">
                                <h4>Meet & Plan</h4>
                                <p>We'll discuss your vision, I'll give you a quote, and we'll get you scheduled.</p>
                            </div>
                        </div>
                    </div>

                    <div class="consultation-note">
                        <p><strong>Why a consultation?</strong> Every tattoo I do is custom. The consultation lets me understand your vision, assess the placement, and give you an accurate quote. No surprises.</p>
                    </div>
                </div>

                <div class="book-form">
                    <h3>Tell Me About Your Tattoo</h3>
                    <form id="consultation-form" name="consultation" method="POST" data-netlify="true">
                        <input type="hidden" name="form-name" value="consultation">
                        
                        <div class="form-row">
                            <div class="form-group">
                                <label for="new-firstName">First Name *</label>
                                <input type="text" id="new-firstName" name="firstName" required>
                            </div>
                            <div class="form-group">
                                <label for="new-lastName">Last Name *</label>
                                <input type="text" id="new-lastName" name="lastName" required>
                            </div>
                        </div>
                        
                        <div class="form-row">
                            <div class="form-group">
                                <label for="new-email">Email *</label>
                                <input type="email" id="new-email" name="email" required>
                            </div>
                            <div class="form-group">
                                <label for="new-phone">Phone *</label>
                                <input type="tel" id="new-phone" name="phone" required>
                            </div>
                        </div>

                        <div class="form-group">
                            <label for="tattooType">What type of tattoo? *</label>
                            <select id="tattooType" name="tattooType" required>
                                <option value="">Select one</option>
                                <option value="portrait">Portrait</option>
                                <option value="realism">Realism</option>
                                <option value="custom">Custom Design</option>
                                <option value="coverup">Cover-Up</option>
                                <option value="other">Other</option>
                            </select>
                        </div>

                        <div class="form-row">
                            <div class="form-group">
                                <label for="placement">Placement *</label>
                                <input type="text" id="placement" name="placement" placeholder="e.g., forearm, back, chest" required>
                            </div>
                            <div class="form-group">
                                <label for="size">Approximate Size *</label>
                                <select id="size" name="size" required>
                                    <option value="">Select size</option>
                                    <option value="small">Small (2-3 inches)</option>
                                    <option value="medium">Medium (4-6 inches)</option>
                                    <option value="large">Large (7-10 inches)</option>
                                    <option value="xlarge">Extra Large (10+ inches)</option>
                                </select>
                            </div>
                        </div>

                        <div class="form-group">
                            <label for="description">Describe Your Idea *</label>
                            <textarea id="description" name="description" placeholder="Tell me everything — the more detail, the better. Include any meaning behind the piece, style preferences, etc." required></textarea>
                        </div>

                        <div class="form-group">
                            <label for="referenceImages">Reference Images (optional)</label>
                            <input type="text" id="referenceImages" name="referenceImages" placeholder="Paste links to any reference images (Pinterest, Google Drive, etc.)">
                        </div>

                        <div class="form-group">
                            <label for="budget">Budget Range</label>
                            <select id="budget" name="budget">
                                <option value="">Select budget</option>
                                <option value="400-800">$400 - $800</option>
                                <option value="800-1500">$800 - $1,500</option>
                                <option value="1500-2500">$1,500 - $2,500</option>
                                <option value="2500+">$2,500+</option>
                                <option value="unsure">Not sure yet</option>
                            </select>
                        </div>

                        <div class="form-group">
                            <label for="hearAbout">How did you hear about me?</label>
                            <select id="hearAbout" name="hearAbout">
                                <option value="">Select one</option>
                                <option value="instagram">Instagram</option>
                                <option value="tiktok">TikTok</option>
                                <option value="google">Google Search</option>
                                <option value="referral">Friend/Referral</option>
                                <option value="other">Other</option>
                            </select>
                        </div>
                        
                        <button type="submit" class="btn btn-primary" style="width: 100%;">Continue to Payment — $50</button>
                        
                        <p class="form-note">After submitting, you'll be redirected to pay the $50 non-refundable consultation fee, then book your time.</p>
                    </form>
                </div>
            </div>
        </div>

        <!-- Returning Client Section -->
        <div class="client-section" id="returning-client">
            <div class="back-link">
                <a href="#" id="backToQuestion2">← Back</a>
            </div>
            <div class="book-grid">
                <div class="book-info">
                    <h2>Welcome Back!</h2>
                    <p>Ready for your next piece? Pay your $200 non-refundable deposit to lock in your session, then pick your appointment time.</p>
                    
                    <div class="book-steps">
                        <div class="book-step">
                            <span class="book-step-number">01</span>
                            <div class="book-step-content">
                                <h4>Quick Details</h4>
                                <p>Fill out the short form so I know what you're coming in for.</p>
                            </div>
                        </div>
                        <div class="book-step">
                            <span class="book-step-number">02</span>
                            <div class="book-step-content">
                                <h4>Pay Deposit</h4>
                                <p>$200 non-refundable deposit secures your spot. Goes toward your total.</p>
                            </div>
                        </div>
                        <div class="book-step">
                            <span class="book-step-number">03</span>
                            <div class="book-step-content">
                                <h4>Book Your Session</h4>
                                <p>Choose your session length and pick a date that works.</p>
                            </div>
                        </div>
                        <div class="book-step">
                            <span class="book-step-number">04</span>
                            <div class="book-step-content">
                                <h4>Get Inked</h4>
                                <p>Show up ready. You know the drill.</p>
                            </div>
                        </div>
                    </div>

                    <div class="consultation-note">
                        <p><strong>Not sure which session length?</strong> Check what we discussed in your consultation. Small pieces = 2-3 hours, Medium = 4-6 hours, Full day = 7+ hours.</p>
                    </div>
                </div>

                <div class="book-form">
                    <h3>Book Your Session</h3>
                    <form id="deposit-form" name="deposit" method="POST" data-netlify="true">
                        <input type="hidden" name="form-name" value="deposit">
                        
                        <div class="form-row">
                            <div class="form-group">
                                <label for="ret-firstName">First Name *</label>
                                <input type="text" id="ret-firstName" name="firstName" required>
                            </div>
                            <div class="form-group">
                                <label for="ret-lastName">Last Name *</label>
                                <input type="text" id="ret-lastName" name="lastName" required>
                            </div>
                        </div>
                        
                        <div class="form-row">
                            <div class="form-group">
                                <label for="ret-email">Email *</label>
                                <input type="email" id="ret-email" name="email" required>
                            </div>
                            <div class="form-group">
                                <label for="ret-phone">Phone *</label>
                                <input type="tel" id="ret-phone" name="phone" required>
                            </div>
                        </div>

                        <div class="form-group">
                            <label for="sessionType">Session Length *</label>
                            <select id="sessionType" name="sessionType" required>
                                <option value="">Select session length</option>
                                <option value="small">Small Session (2-3 hours)</option>
                                <option value="medium">Medium Session (4-6 hours)</option>
                                <option value="fullday">Full Day Session (7+ hours)</option>
                            </select>
                        </div>

                        <div class="form-group">
                            <label for="ret-description">What are we working on? *</label>
                            <textarea id="ret-description" name="description" placeholder="Brief description of your tattoo" required></textarea>
                        </div>

                        <!-- Add-Ons Section -->
                        <div class="addons-section">
                            <h4>Enhance Your Session</h4>
                            <p class="addons-note">Most clients add these — can't purchase day-of</p>
                            
                            <div class="addon-options">
                                <label class="addon-option selected" data-addon="bundle" data-price="90">
                                    <input type="radio" name="addon" value="bundle" checked>
                                    <div class="addon-content">
                                        <div class="addon-header">
                                            <span class="addon-name">Comfort Bundle</span>
                                            <span class="addon-badge">BEST VALUE</span>
                                        </div>
                                        <span class="addon-desc">Numbing cream + Aftercare kit</span>
                                        <span class="addon-price">$90 <span class="addon-savings">Save $20</span></span>
                                    </div>
                                </label>
                                
                                <label class="addon-option" data-addon="numbing" data-price="50">
                                    <input type="radio" name="addon" value="numbing">
                                    <div class="addon-content">
                                        <span class="addon-name">Numbing Cream</span>
                                        <span class="addon-desc">Applied before your session for a more comfortable experience</span>
                                        <span class="addon-price">$50</span>
                                    </div>
                                </label>
                                
                                <label class="addon-option" data-addon="aftercare" data-price="60">
                                    <input type="radio" name="addon" value="aftercare">
                                    <div class="addon-content">
                                        <span class="addon-name">Aftercare Kit</span>
                                        <span class="addon-desc">Everything you need for proper healing</span>
                                        <span class="addon-price">$60</span>
                                    </div>
                                </label>
                                
 <label class="addon-option" data-addon="none" data-price="0">
    <input type="radio" name="addon" value="none">
    <div class="addon-content">
        <span class="addon-name">No Add-Ons</span>
        <span class="addon-desc">Skip for now — these sell out and aren't available day-of</span>
        <span class="addon-price">$0</span>
    </div>
</label>       
</div>
                        </div>
                        
                        <div class="order-summary">
                            <div class="summary-row">
                                <span>Session Deposit</span>
                                <span>$200</span>
                            </div>
                            <div class="summary-row addon-row">
                                <span>Comfort Bundle</span>
                                <span>$90</span>
                            </div>
                            <div class="summary-row total">
                                <span>Total Due Today</span>
                                <span id="totalAmount">$290</span>
                            </div>
                        </div>
                        
                        <button type="submit" class="btn btn-primary" style="width: 100%;" id="depositSubmitBtn">Continue to Payment — $290</button>
                        
                        <p class="form-note">After submitting, you'll be redirected to pay, then book your session.</p>
                    </form>
                </div>
            </div>
        </div>

    </div>
</section>

<!-- Additional Info -->
<section style="background: var(--black); padding: 4rem 0;">
    <div class="container">
        <div class="info-grid">
            <div class="info-card">
                <h3>Consultation Fee</h3>
                <p>The $50 non-refundable consultation fee is required for all new clients. This covers our planning session and goes directly toward your tattoo cost.</p>
            </div>
            <div class="info-card">
                <h3>Session Deposit</h3>
                <p>A $200 non-refundable deposit secures your appointment. It's applied to your final cost. All deposits are final — no refunds, no exceptions.</p>
            </div>
            <div class="info-card">
                <h3>Cancellations</h3>
                <p>All deposits are non-refundable. You may reschedule one time with 48+ hours notice. Less than 48 hours or no-shows forfeit your deposit.</p>
            </div>
        </div>
    </div>
</section>

<style>
/* Client Question */
.client-question {
    text-align: center;
    padding: 1rem 2rem 4rem;
    max-width: 600px;
    margin: 0 auto;
}

.client-question h2 {
    font-family: var(--font-display);
    font-size: 2.5rem;
    text-transform: uppercase;
    letter-spacing: 2px;
    margin-bottom: 1rem;
}

.client-question p {
    opacity: 0.8;
    margin-bottom: 2rem;
}

.question-buttons {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
}

.question-btn {
    padding: 1.5rem 3rem;
    font-family: var(--font-display);
    font-size: 1.3rem;
    letter-spacing: 2px;
    border: 2px solid var(--accent);
    background: transparent;
    color: var(--cream);
    cursor: pointer;
    transition: all 0.3s;
}

.question-btn:hover {
    background: var(--accent);
    color: var(--dark);
}

/* Back Link */
.back-link {
    margin-bottom: 2rem;
}

.back-link a {
    color: var(--accent);
    text-decoration: none;
    font-size: 0.9rem;
}

.back-link a:hover {
    text-decoration: underline;
}

/* Client Sections */
.client-section {
    display: none;
}

.client-section.active {
    display: block;
}

/* Consultation Note */
.consultation-note {
    background: var(--gray);
    padding: 1.5rem;
    border-left: 4px solid var(--accent);
    margin-top: 2rem;
}

.consultation-note p {
    margin: 0;
    font-size: 0.95rem;
    color: var(--cream);
}

/* Form Note */
.form-note {
    text-align: center;
    color: var(--cream);
    opacity: 0.7;
    font-size: 0.85rem;
    margin-top: 1rem;
}

/* Add-Ons Section */
.addons-section {
    margin: 2rem 0;
    padding: 1.5rem;
    background: var(--dark);
    border: 1px solid var(--light-gray);
}

.addons-section h4 {
    font-family: var(--font-display);
    font-size: 1.3rem;
    letter-spacing: 1px;
    margin-bottom: 0.5rem;
}

.addons-note {
    font-size: 0.85rem;
    color: var(--accent);
    margin-bottom: 1.5rem;
}

.addon-options {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
}

.addon-option {
    display: flex;
    align-items: flex-start;
    padding: 1rem;
    background: var(--gray);
    border: 2px solid var(--light-gray);
    cursor: pointer;
    transition: all 0.3s;
}

.addon-option:hover {
    border-color: var(--accent);
}

.addon-option.selected {
    border-color: var(--accent);
    background: rgba(201, 255, 0, 0.1);
}

.addon-option input {
    margin-right: 1rem;
    margin-top: 0.25rem;
    accent-color: var(--accent);
}

.addon-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
}

.addon-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
}

.addon-name {
    font-family: var(--font-display);
    font-size: 1.1rem;
    letter-spacing: 0.5px;
}

.addon-badge {
    background: var(--accent);
    color: var(--dark);
    font-size: 0.65rem;
    font-weight: bold;
    padding: 0.2rem 0.5rem;
    letter-spacing: 0.5px;
}

.addon-desc {
    font-size: 0.85rem;
    color: var(--cream);
    opacity: 0.7;
}

.addon-price {
    font-family: var(--font-display);
    font-size: 1.1rem;
    color: var(--accent);
    margin-top: 0.25rem;
}

.addon-savings {
    font-size: 0.75rem;
    color: var(--cream);
    opacity: 0.8;
    margin-left: 0.5rem;
}

/* Order Summary */
.order-summary {
    background: var(--dark);
    padding: 1.25rem;
    margin: 1.5rem 0;
    border-left: 4px solid var(--accent);
}

.summary-row {
    display: flex;
    justify-content: space-between;
    padding: 0.5rem 0;
    font-size: 0.95rem;
    color: var(--cream);
}

.summary-row.total {
    border-top: 1px solid var(--light-gray);
    margin-top: 0.5rem;
    padding-top: 1rem;
    font-family: var(--font-display);
    font-size: 1.2rem;
}

.summary-row.total span:last-child {
    color: var(--accent);
}

/* Mobile */
@media (max-width: 600px) {
    .client-question h2 {
        font-size: 1.8rem;
    }
    
    .question-btn {
        padding: 1.25rem 2rem;
        font-size: 1.1rem;
        width: 100%;
    }
    
    .addon-header {
        flex-wrap: wrap;
    }
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const clientQuestion = document.getElementById('clientQuestion');
    const newClientSection = document.getElementById('new-client');
    const returningClientSection = document.getElementById('returning-client');
    const btnNo = document.getElementById('btnNo');
    const btnYes = document.getElementById('btnYes');
    const backToQuestion = document.getElementById('backToQuestion');
    const backToQuestion2 = document.getElementById('backToQuestion2');

    // Show new client section
    btnNo.addEventListener('click', function() {
        clientQuestion.style.display = 'none';
        newClientSection.classList.add('active');
    });

    // Show returning client section
    btnYes.addEventListener('click', function() {
        clientQuestion.style.display = 'none';
        returningClientSection.classList.add('active');
    });

    // Back to question
    backToQuestion.addEventListener('click', function(e) {
        e.preventDefault();
        newClientSection.classList.remove('active');
        clientQuestion.style.display = 'block';
    });

    backToQuestion2.addEventListener('click', function(e) {
        e.preventDefault();
        returningClientSection.classList.remove('active');
        clientQuestion.style.display = 'block';
    });

    // Handle consultation form submission
    document.getElementById('consultation-form').addEventListener('submit', function(e) {
        e.preventDefault();
        
        const formData = new FormData(this);
        const data = Object.fromEntries(formData.entries());
        localStorage.setItem('consultationData', JSON.stringify(data));
        
        fetch('/', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: new URLSearchParams(formData).toString()
        }).then(() => {
            window.location.href = '/checkout/consultation/';
        }).catch(error => {
            console.error('Error:', error);
            alert('Something went wrong. Please try again.');
        });
    });

    // Add-ons functionality
    const addonOptions = document.querySelectorAll('.addon-option');
    const addonRow = document.querySelector('.addon-row');
    const totalAmount = document.getElementById('totalAmount');
    const depositSubmitBtn = document.getElementById('depositSubmitBtn');
    const depositBase = 200;
    
    const addonPrices = {
        bundle: 90,
        numbing: 50,
        aftercare: 60,
        none: 0
    };
    
    const addonNames = {
        bundle: 'Comfort Bundle',
        numbing: 'Numbing Cream',
        aftercare: 'Aftercare Kit',
        none: 'No Add-Ons'
    };

    function updateTotal() {
        const selectedAddon = document.querySelector('input[name="addon"]:checked').value;
        const addonPrice = addonPrices[selectedAddon];
        const total = depositBase + addonPrice;
        
        // Update summary
        if (selectedAddon === 'none') {
            addonRow.style.display = 'none';
        } else {
            addonRow.style.display = 'flex';
            addonRow.querySelector('span:first-child').textContent = addonNames[selectedAddon];
            addonRow.querySelector('span:last-child').textContent = '$' + addonPrice;
        }
        
        totalAmount.textContent = '$' + total;
        depositSubmitBtn.textContent = 'Continue to Payment — $' + total;
        
        // Update selected state
        addonOptions.forEach(opt => {
            if (opt.querySelector('input').checked) {
                opt.classList.add('selected');
            } else {
                opt.classList.remove('selected');
            }
        });
    }

    addonOptions.forEach(option => {
        option.addEventListener('click', function() {
            this.querySelector('input').checked = true;
            updateTotal();
        });
    });

    // Handle deposit form submission
    document.getElementById('deposit-form').addEventListener('submit', function(e) {
        e.preventDefault();
        
        const formData = new FormData(this);
        const data = Object.fromEntries(formData.entries());
        localStorage.setItem('depositData', JSON.stringify(data));
        
        fetch('/', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: new URLSearchParams(formData).toString()
        }).then(() => {
            const sessionType = data.sessionType;
            const addon = data.addon || 'none';
            window.location.href = '/checkout/deposit/?session=' + sessionType + '&addon=' + addon;
        }).catch(error => {
            console.error('Error:', error);
            alert('Something went wrong. Please try again.');
        });
    });
});
</script>
