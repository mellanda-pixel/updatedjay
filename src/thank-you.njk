<section class="ty-page">
    <div class="container">
        <div class="ty-box">
            <span class="ty-check">&#10003;</span>
            <span class="section-tag">{{ booking.label }}</span>
            <h1>{{ booking.heading }}</h1>
            <p class="ty-detail">{{ booking.detail }}</p>

            <div class="ty-next">
                <h2>What Happens Next</h2>
                <p>{{ booking.next }}</p>
            </div>

            <div class="ty-links">
                <a href="/" class="btn btn-primary">Back to Site</a>
                <a href="/portfolio/" class="ty-secondary">See More Work</a>
            </div>

            <p class="ty-note">Questions? Text or email me at <a href="mailto:hello@getinkedbyj.com">hello@getinkedbyj.com</a></p>
        </div>
    </div>
</section>

